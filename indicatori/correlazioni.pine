// Riskly · Correlazioni
// Sotto il grafico mostra le ultime candele degli strumenti correlati, sulla stessa scala,
// e quanto ciascuno si è mosso insieme al simbolo del grafico.
//
// Come si usa
// 1. TradingView → Pine Editor → incolla questo file → "Aggiungi al grafico".
// 2. Nelle impostazioni scegli fino a 8 simboli. "Inverti" ribalta le candele
//    (utile per il DXY sull'oro: se il dollaro sale l'oro di solito scende).
// 3. Scala "Variazione %": ogni candela è la variazione rispetto alla chiusura
//    precedente alla prima candela mostrata. "Multipli di ATR" rende confrontabili
//    strumenti con volatilità molto diverse (es. oro e platino).
// 4. ρ sotto ogni simbolo: correlazione dei rendimenti con il grafico sulle ultime
//    N barre. +1 si muovono insieme, −1 all'opposto, 0 nessun legame.
//    Se hai attivato "Inverti", ρ è già ribaltato.

//@version=6
indicator("Riskly · Correlazioni", shorttitle="Correlazioni", overlay=false,
     max_boxes_count=100, max_lines_count=100, max_labels_count=100)

// ── Impostazioni ─────────────────────────────────────────────
GRP_G = "Generale"
tf         = input.timeframe("", "Timeframe delle candele", group=GRP_G)
nCand      = input.int(2, "Candele per simbolo", minval=1, maxval=3, group=GRP_G)
scala      = input.string("Variazione %", "Scala", options=["Variazione %", "Multipli di ATR"], group=GRP_G)
lenCorr    = input.int(50, "Barre per la correlazione (ρ)", minval=10, maxval=500, group=GRP_G)
mostraGraf = input.bool(true, "Mostra anche il simbolo del grafico", group=GRP_G)
mostraRho  = input.bool(true, "Mostra ρ sotto ogni simbolo", group=GRP_G)

GRP_C = "Colori"
colSu    = input.color(#22C55E, "Rialzo",  inline="c", group=GRP_C)
colGiu   = input.color(#EF4444, "Ribasso", inline="c", group=GRP_C)
colTesto = input.color(#8B98A9, "Testo",   inline="c", group=GRP_C)

GRP_S = "Simboli (attivo · simbolo · inverti)"
on1  = input.bool(true, "", inline="s1", group=GRP_S)
s1   = input.symbol("OANDA:AUDUSD", "", inline="s1", group=GRP_S)
inv1 = input.bool(false, "Inverti", inline="s1", group=GRP_S)
on2  = input.bool(true, "", inline="s2", group=GRP_S)
s2   = input.symbol("OANDA:NZDUSD", "", inline="s2", group=GRP_S)
inv2 = input.bool(false, "Inverti", inline="s2", group=GRP_S)
on3  = input.bool(true, "", inline="s3", group=GRP_S)
s3   = input.symbol("OANDA:EURUSD", "", inline="s3", group=GRP_S)
inv3 = input.bool(false, "Inverti", inline="s3", group=GRP_S)
on4  = input.bool(true, "", inline="s4", group=GRP_S)
s4   = input.symbol("OANDA:XAGUSD", "", inline="s4", group=GRP_S)
inv4 = input.bool(false, "Inverti", inline="s4", group=GRP_S)
on5  = input.bool(true, "", inline="s5", group=GRP_S)
s5   = input.symbol("OANDA:XPTUSD", "", inline="s5", group=GRP_S)
inv5 = input.bool(false, "Inverti", inline="s5", group=GRP_S)
on6  = input.bool(true, "", inline="s6", group=GRP_S)
s6   = input.symbol("TVC:DXY", "", inline="s6", group=GRP_S)
inv6 = input.bool(false, "Inverti", inline="s6", group=GRP_S)
on7  = input.bool(false, "", inline="s7", group=GRP_S)
s7   = input.symbol("OANDA:USDJPY", "", inline="s7", group=GRP_S)
inv7 = input.bool(false, "Inverti", inline="s7", group=GRP_S)
on8  = input.bool(false, "", inline="s8", group=GRP_S)
s8   = input.symbol("OANDA:USDCHF", "", inline="s8", group=GRP_S)
inv8 = input.bool(false, "Inverti", inline="s8", group=GRP_S)

usaAtr = scala == "Multipli di ATR"

// ── Dati ─────────────────────────────────────────────────────
type Candela
    float o
    float h
    float l
    float c

type Gruppo
    string nome
    array<Candela> cand
    float rho

// le ultime 3 candele, già normalizzate sul contesto del simbolo richiesto:
// riferimento = chiusura precedente alla prima candela mostrata
dati(simple int n, simple bool atrMode) =>
    float atr = ta.atr(14)
    float ref = close[n]
    float den = atrMode ? atr[n] : ref / 100.0
    [(open - ref) / den, (high - ref) / den, (low - ref) / den, (close - ref) / den,
     (open[1] - ref) / den, (high[1] - ref) / den, (low[1] - ref) / den, (close[1] - ref) / den,
     (open[2] - ref) / den, (high[2] - ref) / den, (low[2] - ref) / den, (close[2] - ref) / den]

nome(string s) =>
    parti = str.split(s, ":")
    parti.get(parti.size() - 1)

crea(string n, bool inv, float o0, float h0, float l0, float c0, float o1, float h1, float l1, float c1,
     float o2, float h2, float l2, float c2, float rho) =>
    oA = array.from(o0, o1, o2), hA = array.from(h0, h1, h2)
    lA = array.from(l0, l1, l2), cA = array.from(c0, c1, c2)
    lista = array.new<Candela>()
    // dalla più vecchia alla più recente
    for k = nCand - 1 to 0
        o = oA.get(k), h = hA.get(k), l = lA.get(k), c = cA.get(k)
        lista.push(inv ? Candela.new(-o, -l, -h, -c) : Candela.new(o, h, l, c))
    Gruppo.new(n, lista, inv ? -rho : rho)

[o0_0, h0_0, l0_0, c0_0, o1_0, h1_0, l1_0, c1_0, o2_0, h2_0, l2_0, c2_0] = request.security(syminfo.tickerid, tf, dati(nCand, usaAtr))
[o0_1, h0_1, l0_1, c0_1, o1_1, h1_1, l1_1, c1_1, o2_1, h2_1, l2_1, c2_1] = request.security(s1, tf, dati(nCand, usaAtr))
rho1 = ta.correlation(ta.change(close), ta.change(request.security(s1, timeframe.period, close)), lenCorr)
[o0_2, h0_2, l0_2, c0_2, o1_2, h1_2, l1_2, c1_2, o2_2, h2_2, l2_2, c2_2] = request.security(s2, tf, dati(nCand, usaAtr))
rho2 = ta.correlation(ta.change(close), ta.change(request.security(s2, timeframe.period, close)), lenCorr)
[o0_3, h0_3, l0_3, c0_3, o1_3, h1_3, l1_3, c1_3, o2_3, h2_3, l2_3, c2_3] = request.security(s3, tf, dati(nCand, usaAtr))
rho3 = ta.correlation(ta.change(close), ta.change(request.security(s3, timeframe.period, close)), lenCorr)
[o0_4, h0_4, l0_4, c0_4, o1_4, h1_4, l1_4, c1_4, o2_4, h2_4, l2_4, c2_4] = request.security(s4, tf, dati(nCand, usaAtr))
rho4 = ta.correlation(ta.change(close), ta.change(request.security(s4, timeframe.period, close)), lenCorr)
[o0_5, h0_5, l0_5, c0_5, o1_5, h1_5, l1_5, c1_5, o2_5, h2_5, l2_5, c2_5] = request.security(s5, tf, dati(nCand, usaAtr))
rho5 = ta.correlation(ta.change(close), ta.change(request.security(s5, timeframe.period, close)), lenCorr)
[o0_6, h0_6, l0_6, c0_6, o1_6, h1_6, l1_6, c1_6, o2_6, h2_6, l2_6, c2_6] = request.security(s6, tf, dati(nCand, usaAtr))
rho6 = ta.correlation(ta.change(close), ta.change(request.security(s6, timeframe.period, close)), lenCorr)
[o0_7, h0_7, l0_7, c0_7, o1_7, h1_7, l1_7, c1_7, o2_7, h2_7, l2_7, c2_7] = request.security(s7, tf, dati(nCand, usaAtr))
rho7 = ta.correlation(ta.change(close), ta.change(request.security(s7, timeframe.period, close)), lenCorr)
[o0_8, h0_8, l0_8, c0_8, o1_8, h1_8, l1_8, c1_8, o2_8, h2_8, l2_8, c2_8] = request.security(s8, tf, dati(nCand, usaAtr))
rho8 = ta.correlation(ta.change(close), ta.change(request.security(s8, timeframe.period, close)), lenCorr)

// ── Disegno, solo sull'ultima barra ──────────────────────────
var array<box>   vBox = array.new<box>()
var array<line>  vLin = array.new<line>()
var array<label> vLab = array.new<label>()
var float scalaSu  = na
var float scalaGiu = na

PASSO   = 3       // barre occupate da una candela (corpo largo 2 + spazio)
DISTACCO = 4      // spazio tra un simbolo e l'altro

if barstate.islast
    for b in vBox
        b.delete()
    for l in vLin
        l.delete()
    for e in vLab
        e.delete()
    vBox.clear(), vLin.clear(), vLab.clear()

    gruppi = array.new<Gruppo>()
    if mostraGraf
        gruppi.push(crea(syminfo.ticker, false, o0_0, h0_0, l0_0, c0_0, o1_0, h1_0, l1_0, c1_0, o2_0, h2_0, l2_0, c2_0, na))
    if on1
        gruppi.push(crea(nome(s1), inv1, o0_1, h0_1, l0_1, c0_1, o1_1, h1_1, l1_1, c1_1, o2_1, h2_1, l2_1, c2_1, rho1))
    if on2
        gruppi.push(crea(nome(s2), inv2, o0_2, h0_2, l0_2, c0_2, o1_2, h1_2, l1_2, c1_2, o2_2, h2_2, l2_2, c2_2, rho2))
    if on3
        gruppi.push(crea(nome(s3), inv3, o0_3, h0_3, l0_3, c0_3, o1_3, h1_3, l1_3, c1_3, o2_3, h2_3, l2_3, c2_3, rho3))
    if on4
        gruppi.push(crea(nome(s4), inv4, o0_4, h0_4, l0_4, c0_4, o1_4, h1_4, l1_4, c1_4, o2_4, h2_4, l2_4, c2_4, rho4))
    if on5
        gruppi.push(crea(nome(s5), inv5, o0_5, h0_5, l0_5, c0_5, o1_5, h1_5, l1_5, c1_5, o2_5, h2_5, l2_5, c2_5, rho5))
    if on6
        gruppi.push(crea(nome(s6), inv6, o0_6, h0_6, l0_6, c0_6, o1_6, h1_6, l1_6, c1_6, o2_6, h2_6, l2_6, c2_6, rho6))
    if on7
        gruppi.push(crea(nome(s7), inv7, o0_7, h0_7, l0_7, c0_7, o1_7, h1_7, l1_7, c1_7, o2_7, h2_7, l2_7, c2_7, rho7))
    if on8
        gruppi.push(crea(nome(s8), inv8, o0_8, h0_8, l0_8, c0_8, o1_8, h1_8, l1_8, c1_8, o2_8, h2_8, l2_8, c2_8, rho8))

    float lo = 0.0
    float hi = 0.0
    for g in gruppi
        for c in g.cand
            if not na(c.h) and not na(c.l)
                lo := math.min(lo, c.l)
                hi := math.max(hi, c.h)
    float rng  = math.max(hi - lo, 1e-9)
    float yLab = lo - rng * 0.06

    int larg = nCand * PASSO + DISTACCO
    int x0   = math.max(bar_index - gruppi.size() * larg + DISTACCO, 0)
    for [i, g] in gruppi
        int xg = x0 + i * larg
        for [j, c] in g.cand
            if not na(c.o) and not na(c.c)
                int x = xg + j * PASSO
                col = c.c >= c.o ? colSu : colGiu
                vLin.push(line.new(x + 1, c.h, x + 1, c.l, color=col))
                vBox.push(box.new(x, math.max(c.o, c.c), x + 2, math.min(c.o, c.c), border_color=col, bgcolor=col))
        string testo = g.nome
        if mostraRho and not na(g.rho)
            testo += "\nρ " + (g.rho >= 0 ? "+" : "") + str.tostring(g.rho, "0.00")
        vLab.push(label.new(xg + int(nCand * PASSO / 2), yLab, testo, style=label.style_label_up,
             color=color.new(color.black, 100), textcolor=colTesto, size=size.small))

    scalaSu  := hi + rng * 0.05
    scalaGiu := yLab - rng * (mostraRho ? 0.35 : 0.2)

// i disegni non muovono la scala del pannello: questi due punti invisibili sì
plot(barstate.islast ? scalaSu  : na, "scala su",  color.new(color.white, 100), editable=false)
plot(barstate.islast ? scalaGiu : na, "scala giù", color.new(color.white, 100), editable=false)
hline(0, "Zero", color=color.new(colTesto, 60), linestyle=hline.style_dotted)
